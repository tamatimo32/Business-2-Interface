# Copy to .env at the repository root. Never commit the resulting .env.
# Process environment variables override this file. Empty values use defaults.
# Variables marked RESERVED are validated now but activated in a later phase.

# ------------------------- Application / branding -------------------------
# development enables Vite-only CORS and development API docs.
# Use production on an appliance; test is intended for automated tests.
APP_ENV=development
# RESERVED: canonical origin for Phase 3 Origin/CSRF checks.
APP_ORIGIN=http://localhost:8000
# Display name is supplied by configuration, never hard-coded in the UI.
PRODUCT_NAME=Local AI
# RESERVED: optional trusted local logo file; relative paths use repository root.
# BRAND_LOGO_PATH=./branding/logo.svg
DEFAULT_LOCALE=en
# Local development binds to loopback. The Docker image binds to 0.0.0.0.
HOST=127.0.0.1
PORT=8000
# Runtime data is ignored by Git. Relative paths use the repository root.
DATA_DIR=./data
# Optional override. Default: sqlite+aiosqlite:///ABSOLUTE_DATA_DIR/app.db
# Only persistent sqlite+aiosqlite file URLs are supported outside tests.
# Prefer an absolute URL path; relative URL paths depend on the process directory.
# DATABASE_URL=sqlite+aiosqlite:////home/you/appliance/data/app.db
# RESERVED: required when authentication/CSRF is implemented in Phase 3.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# false is for local HTTP development only; production cookies must be Secure.
COOKIE_SECURE=false
# Exact origins, JSON array syntax. Ignored outside APP_ENV=development.
# No wildcard origins, credentials in URLs, paths, or trailing slashes.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
# RESERVED: operational display timezone. Database/application logs remain UTC.
TZ=Europe/Brussels

# ------------------------------- Database --------------------------------
# Writer contention timeout in milliseconds.
SQLITE_BUSY_TIMEOUT_MS=5000
# NORMAL favors modest hardware; FULL increases durability at a write-cost.
SQLITE_SYNCHRONOUS=NORMAL
# false: run `alembic upgrade head` explicitly before local startup.
# The Docker image sets true; startup then applies migrations before serving.
AUTO_MIGRATE=false

# -------------------------------- Ollama ---------------------------------
# Backend-only endpoint. Never expose this service to browser/LAN clients.
# Local Ollama default; Docker Compose will override to http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Candidate chat model. Install deliberately; the application never pulls it.
DEFAULT_MODEL=qwen2.5:7b
# RESERVED: multilingual embeddings in Phase 7, also served by Ollama.
EMBEDDING_MODEL=bge-m3
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
# Inactivity/read timeout, not a maximum total generation duration.
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_WRITE_TIMEOUT_SECONDS=30
OLLAMA_POOL_TIMEOUT_SECONDS=5
# Explicit operator model pulls may wait longer between progress records.
OLLAMA_PULL_READ_TIMEOUT_SECONDS=600
OLLAMA_MAX_CONNECTIONS=20
# Maximum size of one upstream NDJSON record, in bytes.
OLLAMA_MAX_STREAM_LINE_BYTES=1048576
OLLAMA_KEEP_ALIVE=5m

# RESERVED: Phase 4 bounded, fair generation scheduling.
MAX_CONCURRENT_GENERATIONS=1
MAX_QUEUED_GENERATIONS=32
MAX_QUEUED_PER_USER=2
GENERATION_TIMEOUT_SECONDS=300
DEFAULT_CONTEXT_TOKENS=8192
MAX_OUTPUT_TOKENS=2048

# RESERVED: Phase 3 local account sessions.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# RESERVED: Phase 7 documents and retrieval. No document routes exist yet.
DOCUMENTS_ENABLED=true
MAX_UPLOAD_BYTES=26214400
DEFAULT_USER_STORAGE_BYTES=1073741824
MAX_DOCUMENTS_PER_CONVERSATION=10
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_CHUNKS=2000
EMBED_BATCH_SIZE=16
INGESTION_WORKERS=1
RAG_TOP_K=6

# RESERVED: Phase 8 optional outbound search. Requires AGPL policy approval.
WEB_SEARCH_ENABLED=false
SEARXNG_BASE_URL=http://searxng:8080

# RESERVED: Phases 9/10 retention and maintenance.
AUDIT_RETENTION_DAYS=365
BACKUP_RETENTION_COUNT=7
